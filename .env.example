# Copiar a .env y ajustar. El archivo .env NO se versiona (ver .gitignore).

# --- Base de datos ---
DB_USER=postgres
DB_PASSWORD=postgres
# Puertos del HOST. Cambialos si ya tienes un Postgres local ocupando el 5432.
USERS_DB_PORT=5432
INVENTORY_DB_PORT=5433
ORDERS_DB_PORT=5434

# --- JWT ---
# Debe tener al menos 32 bytes y ser EL MISMO en los 3 microservicios y en la
# Lambda authorizer. Generar uno con:  openssl rand -base64 48
JWT_SECRET=smartlogix-dev-secret-cambiar-en-produccion-minimo-32-bytes
JWT_EXPIRATION_MS=3600000

# --- AWS / SQS ---
# Dejar vacio en local: sin cola configurada, orders-service omite la publicacion
# y arranca sin necesidad de credenciales de AWS.
SQS_QUEUE_URL=
AWS_REGION=us-east-1

# --- Despliegue en Swarm (solo en el nodo manager) ---
# Etiqueta de imagen a desplegar; el pipeline usa el SHA del commit.
TAG=latest
