{
  "info": {
    "name": "EP2 - Microservicios (users / inventory / orders)",
    "description": "Ejecutar en orden: 1) users, 2) inventory, 3) orders. Los POST guardan automaticamente el id creado en variables de coleccion (userId, productoId, productoId2, pedidoId).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "users", "value": "http://localhost:8081" },
    { "key": "inventory", "value": "http://localhost:8082" },
    { "key": "orders", "value": "http://localhost:8083" },
    { "key": "userId", "value": "1" },
    { "key": "productoId", "value": "1" },
    { "key": "productoId2", "value": "2" },
    { "key": "pedidoId", "value": "1" }
  ],
  "item": [
    {
      "name": "1. users-service (8081)",
      "item": [
        {
          "name": "Login ADMIN -> 200",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"usuario\": \"admin\",\n  \"password\": \"admin123\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{users}}/api/auth/login"
          }
        },
        {
          "name": "Login OPERADOR -> 200",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"usuario\": \"operador\",\n  \"password\": \"operador123\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{users}}/api/auth/login"
          }
        },
        {
          "name": "ERROR - Login credenciales incorrectas -> 401",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"usuario\": \"admin\",\n  \"password\": \"incorrecta\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{users}}/api/auth/login"
          }
        },
        {
          "name": "ERROR - Login sin password -> 400",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"usuario\": \"admin\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{users}}/api/auth/login"
          }
        },
        {
          "name": "Crear usuario (ADMIN) -> 201",
          "event": [
            { "listen": "prerequest", "script": { "exec": ["pm.collectionVariables.set('rut', (10000000 + Math.floor(Math.random() * 89999999)) + '-9');"] } },
            { "listen": "test", "script": { "exec": ["if (pm.response.code === 201) pm.collectionVariables.set('userId', pm.response.json().id);"] } }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Role", "value": "ADMIN" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Ana Perez\",\n  \"email\": \"ana{{$timestamp}}@duoc.cl\",\n  \"rut\": \"{{rut}}\",\n  \"telefono\": \"+56911112222\",\n  \"password\": \"secreto123\",\n  \"rol\": \"OPERADOR\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{users}}/api/users"
          }
        },
        {
          "name": "Listar usuarios activos -> 200",
          "request": { "method": "GET", "url": "{{users}}/api/users" }
        },
        {
          "name": "Obtener usuario por ID -> 200",
          "request": { "method": "GET", "url": "{{users}}/api/users/{{userId}}" }
        },
        {
          "name": "Actualizar perfil (parcial) -> 200",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Ana Maria Perez\",\n  \"telefono\": \"+56999998888\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{users}}/api/users/{{userId}}"
          }
        },
        {
          "name": "Desactivar usuario (ADMIN) -> 200",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Role", "value": "ADMIN" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"active\": false\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{users}}/api/users/{{userId}}/status"
          }
        },
        {
          "name": "Reactivar usuario (ADMIN) -> 200",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Role", "value": "ADMIN" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"active\": true\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{users}}/api/users/{{userId}}/status"
          }
        },
        {
          "name": "ERROR - Eliminar con rol OPERADOR -> 403",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "X-User-Role", "value": "OPERADOR" }],
            "url": "{{users}}/api/users/{{userId}}"
          }
        },
        {
          "name": "ERROR - Crear con rol OPERADOR -> 403",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Role", "value": "OPERADOR" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Juan\",\n  \"email\": \"juan@duoc.cl\",\n  \"rut\": \"11111111-1\",\n  \"password\": \"secreto123\",\n  \"rol\": \"ADMIN\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{users}}/api/users"
          }
        },
        {
          "name": "ERROR - Desactivar con rol OPERADOR -> 403",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Role", "value": "OPERADOR" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"active\": false\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{users}}/api/users/{{userId}}/status"
          }
        },
        {
          "name": "ERROR - Crear sin cabecera X-User-Role -> 401",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Juan\",\n  \"email\": \"juan@duoc.cl\",\n  \"rut\": \"11111111-1\",\n  \"password\": \"secreto123\",\n  \"rol\": \"ADMIN\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{users}}/api/users"
          }
        },
        {
          "name": "ERROR - Datos invalidos -> 400",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Role", "value": "ADMIN" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"X\",\n  \"email\": \"no-es-email\",\n  \"rut\": \"123\",\n  \"password\": \"123\",\n  \"rol\": \"JEFE\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{users}}/api/users"
          }
        },
        {
          "name": "ERROR - Usuario inexistente -> 404",
          "request": { "method": "GET", "url": "{{users}}/api/users/99999" }
        },
        {
          "name": "Eliminar usuario fisicamente (ADMIN) -> 204",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "X-User-Role", "value": "ADMIN" }],
            "url": "{{users}}/api/users/{{userId}}"
          }
        }
      ]
    },
    {
      "name": "2. inventory-service (8082)",
      "item": [
        {
          "name": "Listar categorias -> 200",
          "request": { "method": "GET", "url": "{{inventory}}/api/categories" }
        },
        {
          "name": "Crear categoria -> 201",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Gamer {{$timestamp}}\",\n  \"descripcion\": \"Accesorios gamer\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{inventory}}/api/categories"
          }
        },
        {
          "name": "Crear producto 1 -> 201",
          "event": [{ "listen": "test", "script": { "exec": ["if (pm.response.code === 201) pm.collectionVariables.set('productoId', pm.response.json().id);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"sku\": \"NB-{{$timestamp}}\",\n  \"nombre\": \"Notebook Lenovo\",\n  \"descripcion\": \"14 pulgadas\",\n  \"precio\": 549990.0,\n  \"stock\": 10,\n  \"categoriaId\": 1\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{inventory}}/api/products"
          }
        },
        {
          "name": "Crear producto 2 -> 201",
          "event": [{ "listen": "test", "script": { "exec": ["if (pm.response.code === 201) pm.collectionVariables.set('productoId2', pm.response.json().id);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"sku\": \"MS-{{$timestamp}}\",\n  \"nombre\": \"Mouse inalambrico\",\n  \"descripcion\": \"Bluetooth\",\n  \"precio\": 12990.5,\n  \"stock\": 50,\n  \"categoriaId\": 1\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{inventory}}/api/products"
          }
        },
        {
          "name": "Listar productos con categoria -> 200",
          "request": { "method": "GET", "url": "{{inventory}}/api/products" }
        },
        {
          "name": "Obtener producto por ID -> 200",
          "request": { "method": "GET", "url": "{{inventory}}/api/products/{{productoId}}" }
        },
        {
          "name": "Actualizar stock individual -> 200",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"stock\": 25\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{inventory}}/api/products/{{productoId}}/stock"
          }
        },
        {
          "name": "Actualizar stock masivo -> 200",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "[\n  { \"id\": {{productoId}}, \"newStock\": 100 },\n  { \"id\": {{productoId2}}, \"newStock\": 200 }\n]", "options": { "raw": { "language": "json" } } },
            "url": "{{inventory}}/api/products/bulk-stock"
          }
        },
        {
          "name": "ERROR - Bulk con ID inexistente (rollback) -> 404",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "[\n  { \"id\": {{productoId}}, \"newStock\": 1 },\n  { \"id\": 99999, \"newStock\": 5 }\n]", "options": { "raw": { "language": "json" } } },
            "url": "{{inventory}}/api/products/bulk-stock"
          }
        },
        {
          "name": "ERROR - Categoria inexistente -> 404",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"sku\": \"X-{{$timestamp}}\",\n  \"nombre\": \"Producto X\",\n  \"precio\": 1000,\n  \"stock\": 1,\n  \"categoriaId\": 99999\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{inventory}}/api/products"
          }
        },
        {
          "name": "ERROR - Precio y stock negativos -> 400",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"sku\": \"X-2\",\n  \"nombre\": \"Producto X\",\n  \"precio\": -5,\n  \"stock\": -1,\n  \"categoriaId\": 1\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{inventory}}/api/products"
          }
        },
        {
          "name": "ERROR - Producto inexistente -> 404",
          "request": { "method": "GET", "url": "{{inventory}}/api/products/99999" }
        }
      ]
    },
    {
      "name": "3. orders-service (8083)",
      "item": [
        {
          "name": "Crear pedido (monto calculado en backend) -> 201",
          "event": [{ "listen": "test", "script": { "exec": ["if (pm.response.code === 201) pm.collectionVariables.set('pedidoId', pm.response.json().id);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"usuarioId\": {{userId}},\n  \"items\": [\n    { \"productoId\": {{productoId}}, \"cantidad\": 2 },\n    { \"productoId\": {{productoId2}}, \"cantidad\": 3 }\n  ]\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{orders}}/api/orders"
          }
        },
        {
          "name": "Obtener pedido con detalles -> 200",
          "request": { "method": "GET", "url": "{{orders}}/api/orders/{{pedidoId}}" }
        },
        {
          "name": "Cambiar estado a PAGADO -> 200",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"estado\": \"PAGADO\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{orders}}/api/orders/{{pedidoId}}/status"
          }
        },
        {
          "name": "Cambiar estado a CANCELADO -> 200",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"estado\": \"CANCELADO\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{orders}}/api/orders/{{pedidoId}}/status"
          }
        },
        {
          "name": "ERROR - Estado invalido -> 400",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"estado\": \"XYZ\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{orders}}/api/orders/{{pedidoId}}/status"
          }
        },
        {
          "name": "ERROR - Producto inexistente en inventory -> 404",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"usuarioId\": 1,\n  \"items\": [\n    { \"productoId\": 99999, \"cantidad\": 1 }\n  ]\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{orders}}/api/orders"
          }
        },
        {
          "name": "ERROR - Pedido sin items -> 400",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"usuarioId\": 1,\n  \"items\": []\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{orders}}/api/orders"
          }
        },
        {
          "name": "ERROR - Cantidad 0 -> 400",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"usuarioId\": 1,\n  \"items\": [\n    { \"productoId\": {{productoId}}, \"cantidad\": 0 }\n  ]\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{orders}}/api/orders"
          }
        },
        {
          "name": "ERROR - Pedido inexistente -> 404",
          "request": { "method": "GET", "url": "{{orders}}/api/orders/99999" }
        }
      ]
    },
    {
      "name": "4. Limpieza (opcional)",
      "item": [
        {
          "name": "Eliminar producto 2 -> 204",
          "request": { "method": "DELETE", "url": "{{inventory}}/api/products/{{productoId2}}" }
        },
        {
          "name": "ERROR - Eliminar producto 2 otra vez -> 404",
          "request": { "method": "DELETE", "url": "{{inventory}}/api/products/{{productoId2}}" }
        }
      ]
    }
  ]
}
